# Copy to .env.local for development; set the same keys in Vercel →
# Settings → Environment Variables. See README "Connecting WordPress".

# WordPress
WORDPRESS_GRAPHQL_ENDPOINT="https://cms.yuseavietnam.com/graphql"
WORDPRESS_USE_MOCKS="true"          # "false" once WordPress is live
WORDPRESS_AUTH_TOKEN=""             # optional: drafts / private fields only

# On-demand revalidation (must match YUSEA_REVALIDATE_SECRET in wp-config.php)
REVALIDATE_SECRET=""

# Public origin for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# On Vercel this falls back to the production domain if unset.
SITE_URL="https://yuseavietnam.com"
